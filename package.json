{
  "name": "json-parse-stringify",
  "displayName": "JSON Parse & Stringify - Context Menu",
  "description": "Parse or stringify selected JSON directly from the editor context menu",
  "version": "1.1.0",
  "publisher": "xuyilongs",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.20.0"
  },
  "categories": ["Formatters", "Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xuyilongs/vscode-json-parse-stringify"
  },
  "homepage": "https://github.com/Xuyilongs/vscode-json-parse-stringify#readme",
  "bugs": {
    "url": "https://github.com/Xuyilongs/vscode-json-parse-stringify/issues"
  },
  "keywords": ["json", "parse", "stringify"],
  "author": "NextFaze contributors and Xuyilong",
  "activationEvents": [
    "onCommand:extension.stringifyJson",
    "onCommand:extension.parseJson"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.stringifyJson",
        "title": "Stringify JSON Value",
        "category": "JSON"
      },
      {
        "command": "extension.parseJson",
        "title": "Parse Stringified JSON",
        "category": "JSON"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.parseJson",
          "when": "editorHasSelection",
          "group": "1_modification@10"
        },
        {
          "command": "extension.stringifyJson",
          "when": "editorHasSelection",
          "group": "1_modification@11"
        }
      ]
    },
    "configuration": {
      "type": "string",
      "title": "json-parse-stringify configuration",
      "properties": {}
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test": "npm run compile && node ./node_modules/vscode/bin/test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^2.2.42",
    "@types/node": "7.0.43",
    "tslint": "^5.8.0",
    "typescript": "^2.6.1",
    "vsce": "^1.37.1",
    "vscode": "^1.1.6"
  }
}
