{
  "name": "json-selection-converter",
  "displayName": "JSON Selection Converter",
  "description": "Decode and encode selected JSON text from the editor context menu",
  "version": "1.0.0",
  "publisher": "xuyilongs",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.20.0"
  },
  "categories": ["Formatters", "Other"],
  "keywords": ["json", "selection", "decode", "encode"],
  "author": "Xuyilong",
  "activationEvents": [
    "onCommand:jsonSelectionConverter.decode",
    "onCommand:jsonSelectionConverter.encode"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "jsonSelectionConverter.decode",
        "title": "Decode JSON String",
        "category": "JSON Selection Converter"
      },
      {
        "command": "jsonSelectionConverter.encode",
        "title": "Encode as JSON String",
        "category": "JSON Selection Converter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jsonSelectionConverter.decode",
          "when": "editorHasSelection",
          "group": "2_json_selection_converter@10"
        },
        {
          "command": "jsonSelectionConverter.encode",
          "when": "editorHasSelection",
          "group": "2_json_selection_converter@11"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/selectionConverter.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "7.0.43",
    "typescript": "^2.6.1",
    "vsce": "^1.37.1",
    "vscode": "^1.1.6"
  }
}
